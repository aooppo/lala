# Paid calls remain disabled unless this exact value is set locally.
RUNWAY_ALLOW_LIVE_CALLS=false

# Set only in a local untracked .env or shell environment. Never commit a real key.
RUNWAYML_API_SECRET=

# When true, the CLI refuses live runs above one output.
RUNWAY_LIVE_SMOKE_TEST=false

# Goal 2 video calls require this separate exact permission.
VIDEO_ALLOW_LIVE_CALLS=false

# The first video-provider call is restricted to one 8-12 second talking result.
VIDEO_LIVE_SMOKE_TEST=false

# Required only when HeyGen is the selected talking provider.
HEYGEN_API_KEY=
